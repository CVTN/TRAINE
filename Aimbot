----------------------------------------------------------------------
-- CONTROLES & CAPTURA DE TECLA
----------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	-- Se estiver aguardando o clique do usuário para redefinir o Keybind
	if ListeningForKey then
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			Config.ActivationKey = input.KeyCode
			ListeningForKey = false
			UpdateGUI()
			return
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 
			or input.UserInputType == Enum.UserInputType.MouseButton2 
			or input.UserInputType == Enum.UserInputType.MouseButton3 then
			Config.ActivationKey = input.UserInputType
			ListeningForKey = false
			UpdateGUI()
			return
		end
	end

	if gameProcessed then return end

	-- Checa ativação por Tecla ou por Botão do Mouse
	if input.KeyCode == Config.ActivationKey or input.UserInputType == Config.ActivationKey then
		ActivationHeld = true
	end

	-- Alternar Visibilidade do Menu (Tecla Insert)
	if input.KeyCode == Config.MenuKey then
		MenuVisible = not MenuVisible
		Panel.Visible = MenuVisible
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.KeyCode == Config.ActivationKey or input.UserInputType == Config.ActivationKey then
		ActivationHeld = false
		Indicator.Visible = false
		IndicatorPosition = nil
	end
end)

local function UpdateIndicator(targetPart: BasePart)
	local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
	if not onScreen or screenPoint.Z <= 0 then
		Indicator.Visible = false
		return
	end

	local position = Vector2.new(screenPoint.X, screenPoint.Y)
	if not IndicatorPosition then IndicatorPosition = position end

	IndicatorPosition = IndicatorPosition:Lerp(position, math.clamp(Config.Smoothness, 0, 1))
	Indicator.Position = UDim2.fromOffset(IndicatorPosition.X, IndicatorPosition.Y)
	Indicator.Visible = true
end

----------------------------------------------------------------------
-- LOOP PRINCIPAL (Aim Assist + Visual)
----------------------------------------------------------------------

RunService:BindToRenderStep("LegitimateAimAssist", Enum.RenderPriority.Camera.Value + 1, function()
	if not Config.Enabled or not ActivationHeld then
		Indicator.Visible = false
		IndicatorPosition = nil
		return
	end

	local target = FindBestTarget()

	if target then
		UpdateIndicator(target)
		SmoothAimAt(target)
	else
		Indicator.Visible = false
		IndicatorPosition = nil
	end
end)

UpdateGUI()
