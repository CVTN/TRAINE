	EnabledButton.Text = "System: " .. (Config.Enabled and "ON" or "OFF")
	AutoAimButton.Text = "Auto Aim (Mobile): " .. (Config.AutoAim and "ON" or "OFF")
	PriorityButton.Text = "Priority: " .. (Config.TargetPriority == "Crosshair" and "Crosshair (Centro)" or "Distance (Mais Perto)")
	TeamButton.Text = "Team Check: " .. (Config.TeamCheck and "ON" or "OFF")
	VisibilityButton.Text = "Line of Sight: " .. (Config.RequireLineOfSight and "ON" or "OFF")
	BoneButton.Text = "Target Bone: " .. Config.TargetBone
	
	ActivationKeyBtn.Text = ListeningForActivationKey and "Aguardando tecla..." or ("Hold Key: " .. GetKeyName(Config.ActivationKey))
	MenuKeyBtn.Text = ListeningForMenuKey and "Aguardando tecla..." or ("Menu Key: " .. GetKeyName(Config.MenuKey))
	
	AutoAimButton.TextColor3 = Config.AutoAim and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(230, 232, 238)
	PriorityButton.TextColor3 = Config.TargetPriority == "Distance" and Color3.fromRGB(80, 220, 140) or Color3.fromRGB(230, 232, 238)
end

