----------------------------------------------------------------------
-- EVENTOS DE INPUT
----------------------------------------------------------------------
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if ListeningForActivationKey or ListeningForMenuKey then
		local validKey = nil
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			validKey = input.KeyCode
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 
			or input.UserInputType == Enum.UserInputType.MouseButton2 
			or input.UserInputType == Enum.UserInputType.MouseButton3 then
			validKey = input.UserInputType
		end
		if validKey then
			if ListeningForActivationKey then
				Config.ActivationKey = validKey
				ListeningForActivationKey = false
			elseif ListeningForMenuKey then
				Config.MenuKey = validKey
				ListeningForMenuKey = false
			end
			UpdateButtonsUI()
			return
		end
	end

	if gameProcessed then return end

	if input.KeyCode == Config.ActivationKey or input.UserInputType == Config.ActivationKey then
		ActivationHeld = true
	end

	if input.KeyCode == Config.MenuKey or input.UserInputType == Config.MenuKey then
		ToggleMenu()
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.KeyCode == Config.ActivationKey or input.UserInputType == Config.ActivationKey then
		ActivationHeld = false
	end
end)

local function UpdateVisuals(targetPart: BasePart, distance: number)
	local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
	if not onScreen or screenPoint.Z <= 0 then
		Indicator.Visible = false
		return
	end

	local position = Vector2.new(screenPoint.X, screenPoint.Y)
	if not IndicatorPosition then IndicatorPosition = position end

	IndicatorPosition = IndicatorPosition:Lerp(position, math.clamp(Config.Smoothness * 2, 0, 1))
	Indicator.Position = UDim2.fromOffset(IndicatorPosition.X, IndicatorPosition.Y)
	
	if Config.ShowDistance then
		DistanceLabel.Text = string.format("%.1fm", distance)
	end
	
	Indicator.Visible = true
end

----------------------------------------------------------------------
-- MAIN CORE (RenderStep Loop)
----------------------------------------------------------------------
RunService:BindToRenderStep("ProfessionalAimbot", Enum.RenderPriority.Camera.Value + 1, function()
	if not Config.Enabled then
		Indicator.Visible = false
		IndicatorPosition = nil
		return
	end

	local isAiming = ActivationHeld or Config.AutoAim
	local target, distance = FindBestTarget()

	if target then
		UpdateVisuals(target, distance)
		if isAiming then
			SmoothAimAt(target)
		end
	else
		Indicator.Visible = false
		IndicatorPosition = nil
	end
end)

UpdateButtonsUI()
