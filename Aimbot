local function GetKeyName(key: Enum.KeyCode | Enum.UserInputType): string
	if key == Enum.UserInputType.MouseButton1 then return "Mouse Esquerdo" end
	if key == Enum.UserInputType.MouseButton2 then return "Mouse Direito" end
	if key == Enum.UserInputType.MouseButton3 then return "Mouse Scroll" end
	if key == Enum.UserInputType.Touch then return "Toque de Tela" end
	return key.Name
end

