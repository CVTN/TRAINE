-- NOME FORMATADO DA TECLA SELECIONADA
local function GetKeyName(key: Enum.KeyCode | Enum.UserInputType): string
	if key == Enum.UserInputType.MouseButton1 then return "Mouse Esquerdo (M1)" end
	if key == Enum.UserInputType.MouseButton2 then return "Mouse Direito (M2)" end
	if key == Enum.UserInputType.MouseButton3 then return "Mouse Scroll (M3)" end
	return key.Name
end

local function UpdateGUI()
	EnabledButton.Text = "Enabled: " .. (Config.Enabled and "ON" or "OFF")
	KeybindButton.Text = ListeningForKey and "Pressione uma tecla..." or ("Keybind: " .. GetKeyName(Config.ActivationKey))
	TeamButton.Text = "Team Check: " .. (Config.TeamCheck and "ON" or "OFF")
	VisibilityButton.Text = "Line of Sight: " .. (Config.RequireLineOfSight and "ON" or "OFF")
	BoneButton.Text = "Target Bone: " .. Config.TargetBone
	FOVLabel.Text = "FOV Radius: " .. tostring(Config.FOVRadius)
	SmoothLabel.Text = "Smoothness: " .. string.format("%.2f", Config.Smoothness)
	FOVBox.Text = tostring(Config.FOVRadius)
	SmoothBox.Text = string.format("%.2f", Config.Smoothness)
	FOVCircle.Size = UDim2.fromOffset(Config.FOVRadius * 2, Config.FOVRadius * 2)
end

